// Copy to Secrets.xcconfig (git-ignored) and fill in.
// Windy Point Forecast API key from https://api.windy.com/keys
WINDY_API_KEY = your-key-here

// Thames Water Open Data API (live storm overflow / sewage status) from
// https://data.thameswater.co.uk : register, create an app, copy its client ID and secret
THAMES_WATER_CLIENT_ID = your-client-id
THAMES_WATER_CLIENT_SECRET = your-client-secret
