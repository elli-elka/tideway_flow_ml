// Copy to Secrets.xcconfig (git-ignored) and fill in.
// Windy Point Forecast API key from https://api.windy.com/keys
WINDY_API_KEY = your-key-here

// Thames Water: NOT needed (the v2 Open Data API is open). Only fill these in if
// Thames Water starts requiring a key; the app then sends them as headers.
THAMES_WATER_CLIENT_ID =
THAMES_WATER_CLIENT_SECRET =
